{
  "name": "env-ok",
  "version": "1.0.0",
  "description": "Tiny TypeScript environment validator — env({ PORT: Number, DATABASE: String }) with Enum, Boolean, Email, URL, Port, Secret, and defaults.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "env",
    "environment",
    "validator",
    "config",
    "process.env",
    "typescript",
    "enum",
    "boolean",
    "email",
    "url",
    "port",
    "secret",
    "dotenv",
    "nodejs"
  ],
  "author": "Anil Kumar <anilachary67@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theinfyark/env-ok.git"
  },
  "bugs": {
    "url": "https://github.com/theinfyark/env-ok/issues"
  },
  "homepage": "https://github.com/theinfyark/env-ok#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/anilachary"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
